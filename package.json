{
  "name": "@chatfast/widget",
  "version": "0.1.0",
  "description": "Embeddable AI chat widget (Web Component) for ChatFast",
  "type": "module",
  "main": "./dist/chatfast-widget.umd.cjs",
  "module": "./dist/chatfast-widget.js",
  "exports": {
    ".": {
      "import": "./dist/chatfast-widget.js",
      "require": "./dist/chatfast-widget.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
